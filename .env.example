# Anthropic Claude API Key
# 取得先: https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxx

# Google Maps API Key
# 取得先: Google Cloud Console > APIs & Services > Credentials
# 有効化が必要なAPI: Places API, Distance Matrix API
GOOGLE_MAPS_API_KEY=AIzaxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Google Spreadsheet ID
# スプレッドシートURLの /d/ と /edit の間の文字列
GOOGLE_SHEETS_ID=1N2iyIOqNBRPWb14GwHoXsQT_iWXk6IpE

# Google Service Account JSON ファイルのパス
# Google Cloud Console > IAM & Admin > Service Accounts で作成
# Sheetsにそのサービスアカウントのメールアドレスを編集者として共有すること
GOOGLE_SERVICE_ACCOUNT_JSON=service_account.json
